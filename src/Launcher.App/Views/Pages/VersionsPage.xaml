<UserControl x:Class="Launcher.App.Views.Pages.VersionsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="32,24,32,28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <TextBlock Text="版本管理" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>
  <Border Grid.Row="1" Style="{StaticResource AppleCard}" Padding="12,10" Margin="0,0,0,16"><DockPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="导入整合包" Command="{Binding Main.DownloadsVM.ImportModpackCommand}" Style="{StaticResource AppleSecondaryButton}" Margin="0,0,8,0"/><Button Content="选择目录" Command="{Binding BrowseGameRootCommand}" Style="{StaticResource AppleSecondaryButton}" Margin="0,0,8,0"/><Button Content="刷新" Command="{Binding ScanVersionsCommand}" IsEnabled="{Binding IsScanning,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}" Style="{StaticResource AppleSecondaryButton}"/></StackPanel>
   <TextBlock Text="{Binding GameRoot}" ToolTip="{Binding GameRoot}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,16,0"/>
  </DockPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource AppleCard}" Padding="10"><Grid>
   <TextBlock Text="暂无版本" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Versions.Count,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}"/>
   <ListBox x:Name="VersionsList" Style="{StaticResource VirtualList}" ItemsSource="{Binding Versions}" ScrollViewer.ScrollChanged="ScrollChanged"><ListBox.ItemTemplate><DataTemplate>
     <Border Style="{StaticResource SelectedItemRow}" Margin="0,3" Padding="12,8" MinHeight="58" Cursor="Hand" Focusable="True" MouseLeftButtonDown="VersionClicked" KeyDown="VersionKeyDown" ToolTip="{Binding Error}">
      <Border.Tag><MultiBinding Converter="{StaticResource CurrentItemConverter}"><Binding/><Binding Path="DataContext.Main.CurrentVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></Border.Tag>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid VerticalAlignment="Center" Width="34" Height="34" HorizontalAlignment="Left">
        <Image Source="{Binding Loader,Converter={StaticResource LoaderIconConverter}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Tag,RelativeSource={RelativeSource AncestorType=Border},Converter={StaticResource BoolToVis}}"><TextBlock Text="✓" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       </Grid>
       <TextBlock Grid.Column="1" Text="{Binding GameName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <Border Grid.Column="2" Background="#16007AFF" CornerRadius="8" Padding="9,4" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="220"><TextBlock Text="{Binding TagLabel}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding TagLabel}"/></Border>
       <Button Grid.Column="3" Content="管理" Command="{Binding DataContext.ManageVersionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AppleSecondaryButton}"/>
      </Grid>
     </Border>
    </DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid></Border>
 </Grid>
</UserControl>
