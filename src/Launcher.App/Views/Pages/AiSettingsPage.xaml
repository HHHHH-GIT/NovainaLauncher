<UserControl x:Class="Launcher.App.Views.Pages.AiSettingsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/NovainaLauncher;component/Styles/AgentTimeline.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24" Background="{DynamicResource ContentBrush}">
  <StackPanel MaxWidth="760" Margin="0,8,0,24">
   <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="返回对话" Style="{StaticResource AiOutlinedButton}" Command="{Binding CloseAiSettingsCommand}"/><TextBlock Text="AI 设置" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel>
   <TextBlock Text="连接与模型" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
   <Border Style="{StaticResource AppleCard}"><StackPanel>
    <TextBlock Text="DeepSeek API Key" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
    <PasswordBox x:Name="AiSettingsKey" Style="{StaticResource ApplePasswordBox}" PasswordChanged="KeyChanged" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="DeepSeek API Key"/>
    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,12"/>
    <WrapPanel Margin="0,0,0,20"><Button Content="保存并测试" Style="{StaticResource AiActionButton}" Click="SaveKeyClick" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,8"/><Button Content="刷新模型" Style="{StaticResource AiOutlinedButton}" Command="{Binding RefreshModelsCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,8"/><Button Content="移除密钥" Style="{StaticResource AiOutlinedButton}" Command="{Binding RemoveKeyCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8"/></WrapPanel>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="模型" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" IsEnabled="{Binding CanConfigure}"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="推理档位" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding ReasoningLevels}" SelectedItem="{Binding ReasoningEffort}" IsEnabled="{Binding CanConfigure}"/></Grid>
    <TextBlock Text="配置独立保存。API Key 使用 Windows 加密保护，不写入普通设置文件。" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
   </StackPanel></Border>
   <TextBlock Text="会话与上下文" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,24,0,12"/>
   <Border Style="{StaticResource AppleCard}"><StackPanel>
    <TextBlock Text="{Binding SessionStorageStatus}" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <TextBlock Text="基础模式与工作台分别保存会话。重新打开时保留对话和目标，但不会重放历史操作或恢复旧批准。会话文件按当前 Windows 用户加密，数据迁移会一起保留。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,16"/>
    <TextBlock Text="上下文超过 45% 时在完整操作结束后自动压缩；也可使用 /compact。/goal 设置当前会话的持续目标。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
   </StackPanel></Border>
   <TextBlock Text="工作台权限" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="16" Margin="0,24,0,12"/>
   <Border Style="{StaticResource AppleCard}"><StackPanel>
    <TextBlock Text="Mod 开发项目" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <TextBlock Text="审批模式：文件工具访问已选择的项目，敏感操作和构建信任会请求确认。授权模式：在输入区选择并确认警告后，开放完整终端和文件权限，不再逐项确认或限制项目目录；仅对当前会话有效。权限受 Windows 当前用户权限限制。工作台默认编译和打包，只有明确要求才启动游戏。" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0"/>
    <StackPanel Visibility="{Binding IsWorkbench,Converter={StaticResource BoolToVis}}" Margin="0,16,0,0"><TextBlock Text="{Binding WorkspaceLabel}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/><WrapPanel Margin="0,12,0,0"><Button Content="选择项目" Style="{StaticResource AiOutlinedButton}" Command="{Binding ChooseWorkspaceCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,8"/><Button Content="新建项目" Style="{StaticResource AiOutlinedButton}" Command="{Binding NewWorkspaceCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,8,8"/><Button Content="撤销授权" Style="{StaticResource AiOutlinedButton}" Command="{Binding RevokeWorkspaceCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
