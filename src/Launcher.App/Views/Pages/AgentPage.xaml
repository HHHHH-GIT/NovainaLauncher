<UserControl x:Class="Launcher.App.Views.Pages.AgentPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:Launcher.App.ViewModels" xmlns:pages="clr-namespace:Launcher.App.Views.Pages" xmlns:motion="clr-namespace:Launcher.App.Controls">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/NovainaLauncher;component/Styles/AgentTimeline.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Grid x:Name="AiSurface" ClipToBounds="True" PreviewMouseDown="SurfaceMouseDown">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="ConversationSidebar" Width="208" Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="0,0,1,0" Visibility="{Binding SidebarExpanded,Converter={StaticResource BoolToVis}}">
   <Grid Margin="12,18,12,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <ComboBox x:Name="AgentModeSelector" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedModeChoice}" IsEnabled="{Binding CanManageConversations}" Height="48" Padding="8,4" AutomationProperties.Name="Agent 模式"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <DockPanel Grid.Row="1" Margin="0,18,0,10"><Button DockPanel.Dock="Right" Content="＋" Style="{StaticResource AiQuietButton}" Command="{Binding NewConversationCommand}" IsEnabled="{Binding CanManageConversations}" Width="28" Height="28" MinWidth="0" Padding="0" ToolTip="新对话"/><TextBlock Text="最近会话" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
    <ListBox x:Name="ConversationList" Grid.Row="2" Style="{StaticResource VirtualList}" ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" IsEnabled="{Binding CanManageConversations}">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="8,9" CornerRadius="10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AiChoiceSelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AiChoiceHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Updated,StringFormat={}{0:MM/dd HH:mm}}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="×" Style="{StaticResource AiQuietButton}" MinWidth="0" Width="22" Height="22" Padding="0" Command="{Binding DataContext.DeleteConversationCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="删除会话"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
  <Grid Grid.Column="1">
  <Grid x:Name="ChatSurface" Margin="32,20,32,24" MaxWidth="860">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ShowWelcome}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding ShowAiSettings}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18"><DockPanel>
    <Button x:Name="ConnectionButton" DockPanel.Dock="Right" Content="设置" Style="{StaticResource AiOutlinedButton}" Command="{Binding OpenAiSettingsCommand}"/>
    <Button DockPanel.Dock="Left" Content="☷" Style="{StaticResource AiOutlinedButton}" Command="{Binding ToggleConversationSidebarCommand}" Width="32" MinWidth="0" Padding="0" Margin="0,0,8,0" ToolTip="收起或展开会话列表"/>
    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ModeChoices}" SelectedItem="{Binding SelectedModeChoice}" DisplayMemberPath="Name" Width="105" Margin="0,0,8,0" Visibility="{Binding SidebarExpanded,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}" IsEnabled="{Binding CanManageConversations}"/>
    <Button x:Name="NewConversationButton" DockPanel.Dock="Left" Content="＋ 新对话" Style="{StaticResource AiOutlinedButton}" Command="{Binding NewConversationCommand}" IsEnabled="{Binding CanManageConversations}" Margin="0,0,14,0"/>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="就绪"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </DockPanel>
    <Border Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,10,0,0" Visibility="{Binding IsWorkbench,Converter={StaticResource BoolToVis}}"><StackPanel><TextBlock Text="{Binding WorkspaceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceLabel}"/><WrapPanel Margin="0,6,0,0"><Button Content="选择项目" Style="{StaticResource AiOutlinedButton}" Command="{Binding ChooseWorkspaceCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,6,0"/><Button Content="新建项目" Style="{StaticResource AiOutlinedButton}" Command="{Binding NewWorkspaceCommand}" IsEnabled="{Binding CanConfigure}" Margin="0,0,6,0"/><Button Content="重新授权" Style="{StaticResource AiQuietButton}" Command="{Binding ReauthorizeWorkspaceCommand}" IsEnabled="{Binding CanConfigure}"/></WrapPanel></StackPanel></Border>
    <Border Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6" Margin="0,10,0,0" Visibility="{Binding HasGoal,Converter={StaticResource BoolToVis}}">
     <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="继续" Style="{StaticResource AiQuietButton}" Command="{Binding ContinueGoalCommand}" IsEnabled="{Binding CanConfigure}"/><Button Content="编辑" Style="{StaticResource AiQuietButton}" Command="{Binding OpenGoalCommand}" IsEnabled="{Binding CanConfigure}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="本次会话目标" FontSize="10" Foreground="{StaticResource AiAccentBrush}"/><TextBlock Text="{Binding SessionGoal}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionGoal}"/></StackPanel></DockPanel>
    </Border>
   </StackPanel>
   <Grid Grid.Row="1">
    <StackPanel x:Name="EmptyConversation" Panel.ZIndex="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,32" motion:RevealMotion.Enabled="True">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Timeline.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <Image Source="/NovainaLauncher;component/Assets/Brand/LauncherIcon.png" Width="62" Height="62" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
     <TextBlock Text="{Binding EmptyTitle}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
     <WrapPanel HorizontalAlignment="Center" Visibility="{Binding IsWorkbench,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}"><Button Content="探索一个整合包" Style="{StaticResource AiQuietButton}" Command="{Binding SuggestCommand}" CommandParameter="我想玩一个整合包" Margin="0,0,8,0"/><Button Content="分析启动日志" Style="{StaticResource AiQuietButton}" Command="{Binding SuggestCommand}" CommandParameter="帮我分析当前游戏的启动失败日志"/></WrapPanel>
     <WrapPanel HorizontalAlignment="Center" Visibility="{Binding IsWorkbench,Converter={StaticResource BoolToVis}}"><Button Content="创建第一个 Mod" Style="{StaticResource AiQuietButton}" Command="{Binding SuggestCommand}" CommandParameter="帮我做一个有中文名称、可以合成的新食物 Mod。我是新手，先确认版本和加载器，只需要编译打包。"/><Button Content="修复编译错误" Style="{StaticResource AiQuietButton}" Command="{Binding SuggestCommand}" CommandParameter="检查当前 Mod 项目并修复编译错误，最后构建并说明结果。"/></WrapPanel>
    </StackPanel>
    <ListBox x:Name="TimelineList" Style="{StaticResource VirtualList}" ItemsSource="{Binding Timeline}" Background="Transparent" BorderThickness="0" Padding="0,8,8,20" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="3" HorizontalContentAlignment="Stretch" PreviewMouseWheel="TimelineMouseWheel" PreviewMouseDown="TimelineMouseDown" ScrollViewer.ScrollChanged="TimelineScrolled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,24"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
    </ListBox>
   </Grid>
   <Border Grid.Row="2" x:Name="ComposerSurface" CornerRadius="22" Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" Padding="18,14" Margin="0,10,0,0">
    <StackPanel>
     <Border x:Name="CompactionFeedback" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,8" Visibility="{Binding HasCompactionNotice,Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite">
      <DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource AiQuietButton}" Width="24" Height="24" MinWidth="0" Padding="0" Command="{Binding DismissCompactionNoticeCommand}" IsEnabled="{Binding CanDismissCompactionNotice}" ToolTip="关闭压缩提示" AutomationProperties.Name="关闭压缩提示"/><TextBlock DockPanel.Dock="Left" Text="◔" FontSize="18" Foreground="{StaticResource AiAccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="{Binding CompactionNotice}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel>
     </Border>
     <ItemsControl ItemsSource="{Binding DraftReferences}" Visibility="{Binding HasDraftReferences,Converter={StaticResource BoolToVis}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ControlBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,6,4"><TextBlock Text="{Binding Reference.Name}" ToolTip="{Binding Reference.Detail}" Foreground="{StaticResource AiAccentBrush}" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Grid><TextBox x:Name="Composer" Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="128" MaxLength="16000" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,8,0,4" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" PreviewKeyDown="ComposerKeyDown" TextChanged="ComposerTextChanged" LostKeyboardFocus="ComposerLostFocus" AutomationProperties.Name="告诉启动器你的想法" ToolTip="Enter 发送，Shift+Enter 换行"><TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/></ControlTemplate></TextBox.Template></TextBox><TextBlock x:Name="ComposerPlaceholder" Text="告诉我，你想怎么玩…" FontFamily="{Binding FontFamily,ElementName=Composer}" FontSize="{Binding FontSize,ElementName=Composer}" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" Margin="{Binding Margin,ElementName=Composer}" Padding="2,0,0,0" VerticalAlignment="Top"/></Grid>
     <DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="■" Command="{Binding StopCommand}" Style="{StaticResource AiQuietButton}" Width="40" Height="40" MinWidth="0" Padding="0" Visibility="{Binding IsRunning,Converter={StaticResource BoolToVis}}" ToolTip="停止" AutomationProperties.Name="停止"/><Button Content="↑" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" Style="{StaticResource AiActionButton}" Width="40" Height="40" MinWidth="0" Padding="0" FontSize="20" Visibility="{Binding IsRunning,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}" ToolTip="发送" AutomationProperties.Name="发送"/></StackPanel><StackPanel Orientation="Horizontal"><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" Width="220" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="AI 模型"/><Button x:Name="ContextRingButton" Style="{StaticResource AiQuietButton}" Width="30" Height="30" MinWidth="0" Padding="4" Margin="8,0,0,0" VerticalAlignment="Center" MouseEnter="ContextRingEntered" MouseLeave="ContextRingLeft" Click="ContextRingClicked" AutomationProperties.Name="上下文用量"><motion:ContextUsageRing Width="18" Height="18" Percent="{Binding ContextUsage.Percent}" Track="{DynamicResource AppleCardBorderBrush}" Accent="{StaticResource AiAccentBrush}"/></Button><Button x:Name="PermissionButton" Content="{Binding PermissionLabel}" Click="PermissionClicked" IsEnabled="{Binding CanConfigure}" Height="30" MinWidth="0" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="操作权限"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AiOutlinedButton}"><Style.Triggers><DataTrigger Binding="{Binding IsFullAccess}" Value="True"><Setter Property="Foreground" Value="#FF9F0A"/><Setter Property="BorderBrush" Value="#FF9F0A"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DockPanel>
    </StackPanel>
   </Border>
  </Grid>
  <Popup x:Name="PermissionPopup" Placement="Top" PlacementTarget="{Binding ElementName=PermissionButton}" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="False">
   <Border Width="320" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
    <StackPanel><TextBlock Text="操作权限" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,2,0,10"/>
     <Button Style="{StaticResource AiOutlinedButton}" Command="{Binding UseApprovalModeCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,8"><StackPanel><TextBlock Text="审批模式" FontWeight="SemiBold"/><TextBlock Text="敏感操作与项目访问请求确认" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource AiOutlinedButton}" Command="{Binding OpenFullAccessWarningCommand}" HorizontalContentAlignment="Left" Foreground="#FF9F0A"><StackPanel><TextBlock Text="⚠ 授权模式" FontWeight="SemiBold"/><TextBlock Text="完整终端与文件权限，不再逐项确认" FontSize="11" Margin="0,4,0,0"/></StackPanel></Button>
    </StackPanel>
   </Border>
  </Popup>
  <Grid Panel.ZIndex="20" Visibility="{Binding ShowFullAccessWarning,Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalShadeBrush}">
   <Border MaxWidth="540" Margin="28" VerticalAlignment="Center" Background="{DynamicResource PopupBrush}" BorderBrush="#FF9F0A" BorderThickness="1" CornerRadius="22" Padding="26">
    <StackPanel><TextBlock Text="启用授权模式？" FontSize="22" FontWeight="SemiBold" Foreground="#FF9F0A"/>
     <TextBlock Text="{Binding FullAccessWarning}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22" FontSize="13" Margin="0,16,0,22"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource AiOutlinedButton}" Command="{Binding CancelFullAccessCommand}" Margin="0,0,10,0"/><Button Content="确认启用" Command="{Binding ConfirmFullAccessCommand}" Style="{StaticResource AiOutlinedButton}" Foreground="#FF9F0A"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
  <Popup x:Name="ContextPopup" Placement="Top" PlacementTarget="{Binding ElementName=ContextRingButton}" VerticalOffset="-10" AllowsTransparency="True" StaysOpen="True">
   <Border Width="360" MaxHeight="560" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="上下文用量" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ContextUsageSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,6,0" ToolTip="{Binding ContextUsage.TotalLabel}"/><Button Grid.Column="2" Content="×" Style="{StaticResource AiQuietButton}" Width="24" MinWidth="0" Height="24" Padding="0" Click="ContextPopupClosed" AutomationProperties.Name="关闭上下文用量"/></Grid>
     <motion:ContextUsageBar x:Name="ContextBreakdownBar" Categories="{Binding ContextCategories}" Track="{DynamicResource AppleCardBorderBrush}" Height="5" Margin="0,10,0,12" ToolTip="{Binding ContextUsage.TotalLabel}" AutomationProperties.Name="上下文分类总用量条"/>
     <TextBlock Text="分类明细 · 估算" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,9" ToolTip="{Binding ContextUsage.MeasurementNote}"/>
     <ItemsControl x:Name="ContextCategoryList" ItemsSource="{Binding ContextCategories}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Border Width="7" Height="7" CornerRadius="2" Background="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding TokenLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding PercentLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/></Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Border Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AppleCardBorderBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="剩余空间" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding ContextRemainingTokenLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="{Binding ContextRemainingPercentLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/></Grid>
     <Border Height="1" Background="{DynamicResource AppleCardBorderBrush}" Margin="0,0,0,12"/>
     <TextBlock Text="随着对话轮次增加，上下文会持续累积，模型请求的用量与费用可能相应增加。如需控制后续用量，可手动压缩上下文或开启新对话。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <TextBlock Text="{Binding ContextUsage.CompactionLabel}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource AiAccentBrush}" Margin="0,12,0,0"/><TextBlock Text="{Binding ContextUsage.SavingsLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" Visibility="{Binding ContextUsage.SavingsLabel,Converter={StaticResource BoolToVis}}"/><Button x:Name="ContextCompactButton" Content="压缩上下文" Style="{StaticResource AiOutlinedButton}" Command="{Binding CompactCommand}" IsEnabled="{Binding CanCompact}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Popup>
  <Popup x:Name="SuggestionsPopup" Placement="Top" PlacementTarget="{Binding ElementName=ComposerSurface}" VerticalOffset="-8" AllowsTransparency="True" StaysOpen="True" IsOpen="{Binding ShowSuggestions,Mode=TwoWay}">
   <Border Width="{Binding ActualWidth,ElementName=ComposerSurface}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="6">
    <ListBox x:Name="SuggestionsList" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion,Mode=TwoWay}" Style="{StaticResource VirtualList}" Background="Transparent" BorderThickness="0" MaxHeight="248" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseLeftButtonUp="SuggestionClicked" Focusable="False" HorizontalContentAlignment="Stretch">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SuggestionRow" Background="Transparent" CornerRadius="10" Padding="12,9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="{DynamicResource AiChoiceSelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SuggestionRow" Property="Background" Value="{DynamicResource AiChoiceHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{StaticResource AiAccentBrush}" FontSize="18" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Border>
  </Popup>
  <Grid Visibility="{Binding ShowGoalEditor,Converter={StaticResource BoolToVis}}" Background="{DynamicResource ModalShadeBrush}">
   <Border MaxWidth="600" Margin="28" VerticalAlignment="Center" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="22" Padding="24">
    <StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="×" Style="{StaticResource AiQuietButton}" Command="{Binding CloseGoalCommand}" MinWidth="0" Width="30" Padding="0"/><TextBlock Text="本次会话目标" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/></DockPanel><TextBlock Text="压缩时保留，停止后可继续；新对话会清空。" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,18"/>
     <TextBox x:Name="GoalInput" Style="{StaticResource AiGoalInput}" Text="{Binding GoalDraft,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" MaxLength="8000" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="本次会话目标"/>
     <DockPanel Margin="0,20,0,0"><Button DockPanel.Dock="Right" Content="设置并开始" Style="{StaticResource AiActionButton}" Command="{Binding SaveGoalCommand}" IsEnabled="{Binding CanConfigure}"/><Button Content="清除目标" Style="{StaticResource AiOutlinedButton}" Command="{Binding ClearGoalCommand}" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left"/></DockPanel>
    </StackPanel>
   </Border>
  </Grid>
  <Grid Visibility="{Binding ShowWelcome,Converter={StaticResource BoolToVis}}" MaxWidth="620" Margin="32">
   <StackPanel VerticalAlignment="Center"><TextBlock Text="AI Mode" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AiAccentBrush}" Margin="0,0,0,14"/><TextBlock Text="你的世界，&#10;一句话开启。" FontSize="42" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,32"/>
    <Border Style="{StaticResource AppleCard}"><StackPanel><TextBlock Text="连接 DeepSeek" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/><PasswordBox Style="{StaticResource ApplePasswordBox}" x:Name="ApiKeyBox" PasswordChanged="ApiKeyChanged" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="DeepSeek API Key"/><TextBlock Text="{Binding ConnectionStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,18"/><DockPanel><Button DockPanel.Dock="Right" Content="连接并继续" Style="{StaticResource AiActionButton}" IsEnabled="{Binding CanConfigure}" Click="ConnectClick"/><Button Content="返回对话" HorizontalAlignment="Left" Style="{StaticResource AppleSecondaryButton}" Command="{Binding CloseConnectionCommand}" Visibility="{Binding IsConfigured,Converter={StaticResource BoolToVis}}"/></DockPanel></StackPanel></Border>
   </StackPanel>
  </Grid>
  <Grid x:Name="Intro" Visibility="Collapsed" Background="{DynamicResource PopupBrush}" IsHitTestVisible="False">
   <Ellipse x:Name="AuroraBlue" Width="850" Height="700" Opacity="0" HorizontalAlignment="Left" Margin="-240,-120,0,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#88007AFF"/><GradientStop Color="#00007AFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill><Ellipse.RenderTransform><ScaleTransform ScaleX="0.65" ScaleY="0.65" CenterX="425" CenterY="350"/></Ellipse.RenderTransform></Ellipse>
