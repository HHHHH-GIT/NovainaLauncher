<UserControl x:Class="Launcher.App.Views.Pages.DownloadsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:motion="clr-namespace:Launcher.App.Controls">
 <UserControl.Resources>
  <DataTemplate x:Key="TargetGameItem">
   <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding GameName}" ToolTip="{Binding GameName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Border Grid.Column="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0" Background="#16007AFF" VerticalAlignment="Center"><TextBlock Text="{Binding DownloadTargetTag}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/></Border>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ModFileItem"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,3"/></DataTemplate>
  <Style x:Key="LoadingRing" TargetType="ContentControl">
   <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="IsHitTestVisible" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
    <Viewbox><Grid Width="32" Height="32"><Ellipse Margin="4" Stroke="#22007AFF" StrokeThickness="3"/>
     <Path Data="M16,4 A12,12 0 1 1 4,16" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.RenderTransform><RotateTransform x:Name="SpinnerRotation" CenterX="16" CenterY="16"/></Path.RenderTransform></Path>
    </Grid></Viewbox>
    <ControlTemplate.Triggers><Trigger Property="IsVisible" Value="True"><Trigger.EnterActions><BeginStoryboard Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin"/></Trigger.ExitActions></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WelcomeEntry" TargetType="Button" BasedOn="{StaticResource AppleSecondaryButton}">
   <Setter Property="Height" Value="96"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="28,0"/>
   <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Surface" CornerRadius="24" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
     <Border CornerRadius="24" Background="{DynamicResource GlassLightBrush}" IsHitTestVisible="False"/>
     <Border x:Name="PART_Highlight" CornerRadius="24" Opacity="0" IsHitTestVisible="False"><Border.Background><RadialGradientBrush RadiusX="0.8" RadiusY="1.5"><GradientStop Color="{DynamicResource GlassHighlightColor}"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Border.Background></Border>
     <Border x:Name="Lift" Margin="1" CornerRadius="23" Background="#0A007AFF" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Lift" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LoaderEntry" TargetType="Button" BasedOn="{StaticResource WelcomeEntry}">
   <Setter Property="Height" Value="56"/><Setter Property="Padding" Value="20,0"/>
   <Style.Triggers><DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="#22007AFF"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="WizardProgressStyle" TargetType="motion:AnimatedStepProgressBar">
   <Setter Property="Height" Value="8"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#20007AFF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="motion:AnimatedStepProgressBar"><Grid>
    <Border CornerRadius="4" Background="{TemplateBinding Background}"/>
    <Border x:Name="PART_AnimatedFill" CornerRadius="4" Background="{TemplateBinding Foreground}"/>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SummaryLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
  <Style x:Key="SummaryValue" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource VirtualList}">
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#0C007AFF"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#18007AFF"/><Setter Property="BorderBrush" Value="#50007AFF"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,24"/></Style>
 </UserControl.Resources>
 <Grid x:Name="SurfaceRoot" Margin="32,22,32,24" ClipToBounds="True">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="启动  →" Command="{Binding GoLaunchCommand}" Style="{StaticResource AppleSecondaryButton}" Margin="0,0,10,0" Visibility="{Binding LastInstalled,Converter={StaticResource BoolToVis}}"/>
    <Button Command="{Binding ToggleTasksCommand}" Style="{StaticResource AppleSecondaryButton}" ToolTip="下载任务"><StackPanel Orientation="Horizontal"><TextBlock Text="任务"/><TextBlock Text="{Binding Tasks.Count,StringFormat=  ·  {0}}"/></StackPanel></Button>
   </StackPanel>
   <Button Content="←" Command="{Binding BackCommand}" Style="{StaticResource AppleIconButton}" ToolTip="返回" Margin="0,0,12,0" DockPanel.Dock="Left" Visibility="{Binding IsFlow,Converter={StaticResource BoolToVis}}"/>
   <TextBlock Text="下载" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1" x:Name="FlowSurface">
   <Grid Visibility="{Binding IsWelcome,Converter={StaticResource BoolToVis}}">
    <StackPanel MaxWidth="560" VerticalAlignment="Center" Margin="10,0,10,12">
     <TextBlock Text="新的世界，在此开启。" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,24" motion:WelcomeMotion.Delay="0"/>
     <Button Style="{StaticResource WelcomeEntry}" Command="{Binding BeginFlowCommand}" CommandParameter="Game" Margin="0,0,0,16" motion:WelcomeMotion.Delay="80">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
       <Border Width="48" Height="48" CornerRadius="16" Background="#16007AFF" HorizontalAlignment="Left"><Path Data="M12,1 L23,7 L12,13 L1,7 Z M1,9 L11,15 L11,26 L1,20 Z M13,15 L23,9 L23,20 L13,26 Z" Fill="{DynamicResource AccentBrush}" Width="25" Height="28" Stretch="Uniform"/></Border>
       <TextBlock Grid.Column="1" Text="游戏版本" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="→" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
      </Grid>
     </Button>
     <Button Style="{StaticResource WelcomeEntry}" Command="{Binding BeginFlowCommand}" CommandParameter="Mod" Margin="0,0,0,16" motion:WelcomeMotion.Delay="160">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
       <Border Width="48" Height="48" CornerRadius="16" Background="#16AF52DE" HorizontalAlignment="Left"><Path Data="M4,4 L10,4 C7,0 17,0 14,4 L20,4 L20,10 C24,7 24,17 20,14 L20,20 L14,20 C17,24 7,24 10,20 L4,20 L4,14 C0,17 0,7 4,10 Z" Fill="#AF52DE" Width="28" Height="28" Stretch="Uniform"/></Border>
       <TextBlock Grid.Column="1" Text="模组" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="→" FontSize="24" Foreground="#AF52DE" VerticalAlignment="Center"/>
      </Grid>
     </Button>
     <Button Style="{StaticResource WelcomeEntry}" Command="{Binding BeginFlowCommand}" CommandParameter="Pack" motion:WelcomeMotion.Delay="240">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
       <Border Width="48" Height="48" CornerRadius="16" Background="#1830B879" HorizontalAlignment="Left"><Path Data="M2,7 L14,1 L26,7 L14,13 Z M2,10 L12,15 L12,27 L2,22 Z M16,15 L26,10 L26,22 L16,27 Z" Fill="#30B879" Width="28" Height="28" Stretch="Uniform"/></Border>
       <TextBlock Grid.Column="1" Text="整合包" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
       <TextBlock Grid.Column="2" Text="→" FontSize="24" Foreground="#30B879" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </StackPanel>
   </Grid>
   <Grid Visibility="{Binding IsFlow,Converter={StaticResource BoolToVis}}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="8,6,0,22" motion:WelcomeMotion.Delay="0">
     <TextBlock Text="{Binding StepLabel}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock x:Name="HeroTitle" Text="{Binding StepTitle}" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
    </StackPanel>
    <Grid Grid.Row="1" x:Name="StepSurface" ClipToBounds="True">
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Game0}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <DockPanel Margin="8,0,8,16"><CheckBox DockPanel.Dock="Right" Content="快照" IsChecked="{Binding Snapshots}" Style="{StaticResource GlassCheck}" Margin="18,0,0,0"/><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextBox}" KeyDown="SearchKeyDown" AutomationProperties.Name="搜索游戏版本"/></DockPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Style="{StaticResource ChoiceList}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="20,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Game1}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,8,12,12">
       <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Minecraft" Style="{StaticResource SummaryLabel}"/><TextBlock Text="{Binding SelectedGame.Id}" Style="{StaticResource SummaryValue}" FontSize="18"/></StackPanel>
       <Button Style="{StaticResource LoaderEntry}" Command="{Binding SelectLoaderCommand}" CommandParameter="原版" Tag="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=原版}" Margin="0,0,0,8" motion:WelcomeMotion.Delay="40"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image Source="{Binding CommandParameter,RelativeSource={RelativeSource AncestorType=Button},Converter={StaticResource LoaderIconConverter}}" Width="36" Height="36" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="原版" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=原版}"/></Grid></Button>
       <Button Style="{StaticResource LoaderEntry}" Command="{Binding SelectLoaderCommand}" CommandParameter="Forge" Tag="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=Forge}" Margin="0,0,0,8" motion:WelcomeMotion.Delay="80"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image Source="{Binding CommandParameter,RelativeSource={RelativeSource AncestorType=Button},Converter={StaticResource LoaderIconConverter}}" Width="36" Height="36" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Forge" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=Forge}"/></Grid></Button>
       <Button Style="{StaticResource LoaderEntry}" Command="{Binding SelectLoaderCommand}" CommandParameter="Fabric" Tag="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=Fabric}" Margin="0,0,0,8" motion:WelcomeMotion.Delay="120"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image Source="{Binding CommandParameter,RelativeSource={RelativeSource AncestorType=Button},Converter={StaticResource LoaderIconConverter}}" Width="36" Height="36" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="Fabric" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=Fabric}"/></Grid></Button>
       <Button Style="{StaticResource LoaderEntry}" Command="{Binding SelectLoaderCommand}" CommandParameter="NeoForge" Tag="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=NeoForge}" Margin="0,0,0,12" motion:WelcomeMotion.Delay="160"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><Image Source="{Binding CommandParameter,RelativeSource={RelativeSource AncestorType=Button},Converter={StaticResource LoaderIconConverter}}" Width="36" Height="36" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="NeoForge" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Visibility="{Binding LoaderKind,Converter={StaticResource EqualConverter},ConverterParameter=NeoForge}"/></Grid></Button>
       <StackPanel Visibility="{Binding UsesLoader,Converter={StaticResource BoolToVis}}"><TextBlock Text="加载器版本" Style="{StaticResource Label}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}" IsEnabled="{Binding IsLoadingComponents,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}"/></StackPanel>
      </StackPanel></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Game2}">
      <StackPanel MaxWidth="620" VerticalAlignment="Center" Margin="12,0,12,16" motion:WelcomeMotion.Delay="80">
       <TextBlock Text="OptiFine" Style="{StaticResource Value}" FontSize="32"/>
       <CheckBox Content="添加 OptiFine" IsChecked="{Binding UseOptiFine}" Style="{StaticResource GlassCheck}" Margin="0,0,0,24"/>
       <ComboBox ItemsSource="{Binding OptiFineVersions}" SelectedItem="{Binding SelectedOptiFine}" Visibility="{Binding UseOptiFine,Converter={StaticResource BoolToVis}}"/>
       <TextBlock Text="{Binding CompatibilityText}" Foreground="#DA5963" Margin="0,16,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Game3}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,10,12,12" motion:WelcomeMotion.Delay="80">
       <TextBlock Text="游戏名称" Style="{StaticResource Label}"/><TextBox Text="{Binding GameName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextBox}" MaxLength="100" Margin="0,0,0,28"/>
       <Border Style="{StaticResource AppleCard}" Padding="22"><StackPanel>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Minecraft" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedGame.Id}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="加载器" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding LoaderKind}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16" Visibility="{Binding UsesLoader,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="加载器版本" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedLoader.Version}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16" Visibility="{Binding UseOptiFine,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="OptiFine" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedOptiFine.Edition}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="安装目录" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding GameInstallDirectory}" ToolTip="{Binding GameInstallDirectory}" Style="{StaticResource SummaryValue}"/></Grid>
       </StackPanel></Border>
      </StackPanel></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding IsBrowse,Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="8,0,8,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextBox}" KeyDown="SearchKeyDown" AutomationProperties.Name="搜索模组"/><ComboBox Grid.Column="1" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" Width="128" Margin="12,0,0,0"/><Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}" Style="{StaticResource AppleSecondaryButton}" Margin="12,0,0,0"/></Grid>
      <ListBox x:Name="ModProjectsList" Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Style="{StaticResource ChoiceList}"><ListBox.ItemTemplate><DataTemplate><Grid Margin="18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><motion:ModProjectIcon Url="{Binding IconUrl}" PreferMirror="{Binding DataContext.Main.Settings.PreferContentMirror,RelativeSource={RelativeSource AncestorType=ListBox}}" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <DockPanel Grid.Row="2" Margin="8,14,8,0"><Button DockPanel.Dock="Right" Content="更多" Command="{Binding LoadMoreCommand}" Style="{StaticResource AppleSecondaryButton}"/><Button Content="导入本地整合包" Command="{Binding ImportModpackCommand}" Style="{StaticResource AppleSecondaryButton}" HorizontalAlignment="Left" Visibility="{Binding IsModpack,Converter={StaticResource BoolToVis}}"/></DockPanel>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Mod1}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,4,12,16" motion:WelcomeMotion.Delay="80">
       <DockPanel Margin="0,0,0,24"><Button x:Name="RefreshModVersions" DockPanel.Dock="Right" Content="↻" Command="{Binding RetryReleasesCommand}" Style="{StaticResource AppleIconButton}" ToolTip="刷新版本" AutomationProperties.Name="刷新模组版本" Margin="12,0,0,0"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsFetchingReleases,Converter={StaticResource BoolToVis}}"><ContentControl x:Name="ModVersionsLoading" Style="{StaticResource LoadingRing}" ToolTip="正在获取版本"/><TextBlock Text="{Binding ReleaseLoadingLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><motion:ModProjectIcon Url="{Binding SelectedProject.IconUrl}" PreferMirror="{Binding Main.Settings.PreferContentMirror}" Width="48" Height="48" Margin="0,0,18,0"/><TextBlock Text="{Binding SelectedProject.DisplayName}" ToolTip="{Binding SelectedProject.DisplayName}" TextTrimming="CharacterEllipsis" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/></DockPanel>
       <TextBlock Text="目标游戏" Style="{StaticResource Label}"/><ComboBox x:Name="ModTargetGame" Height="48" ItemsSource="{Binding Main.VersionsVM.Versions}" SelectedItem="{Binding Target}" ItemTemplate="{StaticResource TargetGameItem}" Margin="0,0,0,24"/>
       <Grid IsEnabled="{Binding HasModReleaseOptions}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="游戏版本" Style="{StaticResource Label}"/><ComboBox x:Name="ModGameVersionFilter" Height="46" ItemsSource="{Binding ModGameVersions}" SelectedItem="{Binding ModGameVersion}" Margin="0,0,0,22"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="加载器" Style="{StaticResource Label}"/><ComboBox x:Name="ModLoaderFilter" Height="46" ItemsSource="{Binding ModLoaders}" SelectedItem="{Binding ModLoader}" Margin="0,0,0,22"/></StackPanel>
       </Grid>
       <TextBlock Text="模组版本" Style="{StaticResource Label}"/><ComboBox x:Name="ModVersionFilter" Height="48" IsEnabled="{Binding HasModReleaseOptions}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" ItemTemplate="{StaticResource ModFileItem}" Margin="0,0,0,24"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox>
       <TextBlock Text="{Binding SelectedProject.Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>
       <Button Content="项目详情 ↗" Command="{Binding OpenProjectCommand}" Style="{StaticResource AppleSecondaryButton}" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Mod2}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,10,12,12" motion:WelcomeMotion.Delay="80">
       <TextBlock Text="{Binding SelectedProject.DisplayName}" Style="{StaticResource Value}" FontSize="30" TextWrapping="Wrap"/>
       <Border Style="{StaticResource AppleCard}" Padding="22"><StackPanel>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="目标游戏" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding Target.GameName}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="目标版本" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding Target.DownloadTargetTag}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="模组版本" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedRelease.Name}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Minecraft" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding ReleaseMinecraft}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="加载器" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding ReleaseLoaders}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="安装目录" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding ContentDirectory}" ToolTip="{Binding ContentDirectory}" Style="{StaticResource SummaryValue}"/></Grid>
       </StackPanel></Border>
      </StackPanel></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Pack1}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,8,12,16" motion:WelcomeMotion.Delay="80">
       <DockPanel Margin="0,0,0,24"><motion:ModProjectIcon Url="{Binding SelectedProject.IconUrl}" PreferMirror="{Binding Main.Settings.PreferContentMirror}" Width="52" Height="52" Margin="0,0,18,0"/><TextBlock Text="{Binding SelectedProject.DisplayName}" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0"/></DockPanel>
       <StackPanel Orientation="Horizontal" Visibility="{Binding IsFetchingReleases,Converter={StaticResource BoolToVis}}" Margin="0,0,0,16"><ContentControl Style="{StaticResource LoadingRing}"/><TextBlock Text="{Binding ReleaseLoadingLabel}" Style="{StaticResource Label}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
       <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="↻" Command="{Binding RetryReleasesCommand}" Style="{StaticResource AppleIconButton}" ToolTip="刷新版本"/><TextBlock Text="整合包版本" Style="{StaticResource Label}" VerticalAlignment="Center"/></DockPanel>
       <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" ItemTemplate="{StaticResource ModFileItem}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Margin="0,0,0,24"><ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel></ComboBox>
       <TextBlock Text="游戏名称" Style="{StaticResource Label}"/><TextBox Text="{Binding PackName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppleTextBox}" MaxLength="100" Margin="0,0,0,20"/>
       <TextBlock Text="{Binding SelectedRelease.VersionLabel}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
       <TextBlock Text="{Binding SelectedProject.Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel></ScrollViewer>
     </Grid>
     <Grid Visibility="{Binding Screen,Converter={StaticResource EqualConverter},ConverterParameter=Pack2}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="620" Margin="12,10,12,12" motion:WelcomeMotion.Delay="80">
       <TextBlock Text="游戏名称" Style="{StaticResource Label}"/><TextBlock Text="{Binding PackName}" Style="{StaticResource Value}" FontSize="30" TextWrapping="Wrap"/>
       <Border Style="{StaticResource AppleCard}" Padding="22"><StackPanel>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="整合包" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedProject.DisplayName}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="文件版本" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding SelectedRelease.Name}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="Minecraft" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding ReleaseMinecraft}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="加载器" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding ReleaseLoaders}" Style="{StaticResource SummaryValue}"/></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="安装目录" Style="{StaticResource SummaryLabel}"/><TextBlock Grid.Column="1" Text="{Binding PackInstallDirectory}" ToolTip="{Binding PackInstallDirectory}" Style="{StaticResource SummaryValue}"/></Grid>
       </StackPanel></Border>
      </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="8,16,8,0">
   <ProgressBar Style="{StaticResource AppleProgressBar}" Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading,Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
   <ProgressBar Style="{StaticResource AppleProgressBar}" Height="3" IsIndeterminate="True" Visibility="{Binding IsLoadingComponents,Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
   <TextBlock Text="{Binding Status}" Foreground="#DA5963" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <Grid Visibility="{Binding IsFlow,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,28,0"><DockPanel Margin="0,0,0,8"><TextBlock Text="{Binding StepNumber}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding Source}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><motion:AnimatedStepProgressBar x:Name="WizardProgress" Value="{Binding StepProgress,Mode=OneWay}" Maximum="100" Style="{StaticResource WizardProgressStyle}"/></StackPanel>
    <Button Grid.Column="1" Content="{Binding ContinueLabel}" Command="{Binding ContinueCommand}" IsEnabled="{Binding CanContinue}" Style="{StaticResource ApplePrimaryButton}" MinWidth="124"/>
   </Grid>
  </StackPanel>
  <Border Grid.RowSpan="3" Background="Transparent" Visibility="{Binding ShowTasks,Converter={StaticResource BoolToVis}}" motion:RevealMotion.Enabled="True" KeyboardNavigation.TabNavigation="Cycle">
   <Border x:Name="TaskPanel" Style="{StaticResource DialogCard}" Width="600" Height="480" MaxWidth="{Binding ActualWidth,ElementName=SurfaceRoot}" MaxHeight="{Binding ActualHeight,ElementName=SurfaceRoot}" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="完成" Command="{Binding ToggleTasksCommand}" Style="{StaticResource AppleSecondaryButton}"/><TextBlock Text="下载任务" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
 <TextBlock Grid.Row="1" Text="暂无任务" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Tasks.Count,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}"/>
 <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" Style="{StaticResource VirtualList}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,18">
  <TextBlock Text="{Binding Info.Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
  <motion:TaskProgressView Task="{Binding Info}" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" Accent="{DynamicResource AccentBrush}" Margin="0,12,0,12"/>
  <StackPanel Orientation="Horizontal"><Button Content="取消" Command="{Binding DataContext.CancelTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Info}" Style="{StaticResource AppleSecondaryButton}" Visibility="{Binding Info.IsActive,Converter={StaticResource BoolToVis}}"/><Button Content="重试" Command="{Binding DataContext.RetryTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Info}" Style="{StaticResource AppleSecondaryButton}" Visibility="{Binding Info.CanRetry,Converter={StaticResource BoolToVis}}" Margin="0,0,10,0"/><Button Content="移除" Command="{Binding DataContext.RemoveTaskCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Info}" Style="{StaticResource AppleSecondaryButton}" Visibility="{Binding Info.CanRemove,Converter={StaticResource BoolToVis}}"/></StackPanel>
 </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
</Grid>
   </Border>
  </Border>
 </Grid>
</UserControl>


