<Window x:Class="Launcher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Launcher.App.Controls"
        xmlns:pages="clr-namespace:Launcher.App.Views.Pages"
        mc:Ignorable="d"
        Title="Novaina Launcher"
        Icon="/NovainaLauncher;component/Assets/Brand/LauncherIcon.ico"
        Height="700" Width="1080"
        MinWidth="920" MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="False"
        AllowDrop="True" PreviewDragOver="Files_DragOver" PreviewDrop="Files_Drop"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LaunchViewModel}"><pages:LaunchPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}"><pages:DownloadsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}"><pages:VersionsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}"><pages:AccountsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><pages:LogsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionContentViewModel}"><pages:VersionContentPage /></DataTemplate>
    </Window.Resources>
    <!-- Outer Window Chrome with Apple Rounded Corners and Shadow -->
    <Grid>
        <Border CornerRadius="18" 
                Background="{DynamicResource AppleWindowBackgroundBrush}" x:Name="WindowSurface"
                BorderBrush="{DynamicResource AppleWindowBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">

            <Grid ClipToBounds="True">
              <Grid x:Name="LauncherShell" Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom Apple Title Bar -->
                <Border x:Name="TitleBar" Grid.Row="0" Height="46" Background="#10FFFFFF" BorderBrush="#12000000" BorderThickness="0,0,0,1"
                        >
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Traffic Lights & Branding -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Apple Traffic Light Buttons -->
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TrafficCloseButtonStyle}" Click="CloseButton_Click" ToolTip="关闭" />
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TrafficMinimizeButtonStyle}" Click="MinimizeButton_Click" ToolTip="最小化" />

                            <!-- Brand Logo / Title -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Image x:Name="LauncherBrandIcon" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Source><BitmapImage UriSource="/NovainaLauncher;component/Assets/Brand/LauncherIcon.png" DecodePixelWidth="64" CacheOption="OnLoad"/></Image.Source>
                                </Image>
                                <TextBlock VerticalAlignment="Center" FontSize="14">
                                    <Run Text="Novaina" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" Launcher" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Topbar Navigation (Visible when Sidebar is Collapsed) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding TopNavigationVisible, Converter={StaticResource BoolToVis}}">
                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="启动"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Launch}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Launch">
                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>

                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="版本"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Versions}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Versions">
                                <Path Data="{StaticResource IconVersions}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>

                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="下载"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Downloads}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                                <Path Data="M7,0 L10,0 10,9 14,5 16,7 8.5,14 1,7 3,5 7,9 Z M0,16 L17,16 17,18 0,18 Z" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="账户"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Accounts}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Accounts">
                                <Path Data="{StaticResource IconAccounts}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>

                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="日志"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Logs}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Logs">
                                <Path Data="{StaticResource IconLogs}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>

                            <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleTopNavButtonStyle}" ToolTip="设置"
                                         IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </RadioButton>
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleIconButton}" Click="SettingsMenu_Click" ToolTip="设置分组"
                                    Visibility="{Binding CurrentPage,Converter={StaticResource EqualConverter},ConverterParameter=Settings}">
                                <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="8" Height="4" Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <!-- Right: Actions (Danmaku Toggle, Sidebar Toggle) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                            <TextBlock Text="AI Mode" Foreground="{StaticResource AiAccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox x:Name="AiModeSwitch" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AiModeToggle}" IsChecked="{Binding IsAiMode,Mode=TwoWay}" IsEnabled="{Binding AgentVM.IsStopping,Converter={StaticResource BoolToVis},ConverterParameter=Inverse}" ToolTip="AI Mode" AutomationProperties.Name="AI Mode"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Visibility="{Binding NormalNavigationVisible,Converter={StaticResource BoolToVis}}">
                            <!-- Quick Danmaku Cycle Button -->
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleIconButton}" Command="{Binding CycleDanmakuModeCommand}" ToolTip="{Binding DanmakuModeLabel}" Margin="0,0,8,0">
                                <Grid>
                                    <Path Data="{StaticResource IconDanmaku}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                                    <!-- Subtle indicator if on -->
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                             Visibility="{Binding DanmakuMode, Converter={StaticResource DanmakuActiveConverter}}" />
                                </Grid>
                            </Button>

                            <!-- Sidebar Toggle Button -->
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleIconButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="切换侧边栏形态">
                                <Path Data="{StaticResource IconSidebar}" Fill="{DynamicResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid x:Name="NormalSurface" Grid.Row="1" Visibility="{Binding NormalSurfaceVisible,Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Collapsible Sidebar (Mode A) -->
                    <Border x:Name="SidebarBorder" Grid.Column="0" Width="200" Background="#0CFFFFFF" BorderBrush="#14000000" BorderThickness="0,0,1,0"
                            ClipToBounds="True">
                        <Grid Width="174" HorizontalAlignment="Left" Margin="12,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Navigation List -->
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Launch}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Launch">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="启 动" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Versions}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Versions">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconVersions}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="版 本" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Downloads}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7,0 L10,0 10,9 14,5 16,7 8.5,14 1,7 3,5 7,9 Z M0,16 L17,16 17,18 0,18 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="下 载" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Accounts}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Accounts">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAccounts}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="账 户" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Logs}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Logs">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconLogs}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="日 志" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource AppleNavButtonStyle}"
                                             IsChecked="{Binding CurrentPage, Mode=OneWay, Converter={StaticResource EqualConverter}, ConverterParameter=Settings}"
                                             Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" />
                                        <TextBlock Text="设 置" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <StackPanel Margin="26,4,0,0" Visibility="{Binding CurrentPage,Converter={StaticResource EqualConverter},ConverterParameter=Settings}">
                                    <RadioButton Content="外观与动画" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Appearance" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Appearance}" />
                                    <RadioButton Content="弹幕" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Danmaku" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Danmaku}" />
                                    <RadioButton Content="启动" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Launch" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Launch}" />
                                    <RadioButton Content="Java" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Java" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Java}" />
                                    <RadioButton Content="下载" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Downloads" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Downloads}" />
                                    <RadioButton Content="数据" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Data" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Data}" />
                                    <RadioButton Content="AI" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="AI" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=AI}" />
                                    <RadioButton Content="高级" Style="{StaticResource SettingsSubNav}" Command="{Binding SettingsVM.NavigateSectionCommand}" CommandParameter="Advanced" IsChecked="{Binding SettingsVM.SelectedSection,Mode=OneWay,Converter={StaticResource EqualConverter},ConverterParameter=Advanced}" />
                                </StackPanel>
                            </StackPanel></ScrollViewer>

                            <!-- Sidebar Footer: Collapse button -->
                            <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Row="1" Style="{StaticResource AppleSecondaryButton}" Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSidebar}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="收起侧栏" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Active Page Container -->
                    <Grid Grid.Column="1">
                        <!-- Pages with Slide/Fade animation host -->
                        <Grid x:Name="PageContainer" ClipToBounds="True">
                            <controls:TransitionHost x:Name="PageHost" Content="{Binding CurrentViewModel}" />
                        </Grid>

                        <!-- Danmaku Canvas: Translucent floating animated log text overlay -->
                        <Canvas x:Name="DanmakuCanvas" IsHitTestVisible="False" ClipToBounds="True" />
                    </Grid>
                </Grid>
                <pages:AgentPage x:Name="AgentSurface" Grid.Row="1" DataContext="{Binding AgentVM}" Visibility="{Binding DataContext.AiSurfaceVisible,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Row="1" Content="完成，返回 AI" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource AppleSecondaryButton}" Margin="28,20" Click="AccountLoginDone" Visibility="{Binding AccountLoginRequested,Converter={StaticResource BoolToVis}}" Panel.ZIndex="20"/>
                <Border x:Name="DialogShade" Grid.RowSpan="2" Background="{DynamicResource ModalShadeBrush}" Visibility="Collapsed" Panel.ZIndex="100"/>
              </Grid>
              <controls:StartupAnimation x:Name="StartupScene" Panel.ZIndex="200"/>
            </Grid>
        </Border>
    </Grid>
</Window>


