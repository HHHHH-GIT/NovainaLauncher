<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:Launcher.App.ViewModels" xmlns:motion="clr-namespace:Launcher.App.Controls">
 <Style x:Key="AiQuietButton" TargetType="Button" BasedOn="{StaticResource AppleSecondaryButton}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppleSubtleHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AiAccentBrush}"/></Trigger>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AiActionButton" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButton}"><Setter Property="Background" Value="{StaticResource AiAccentBrush}"/></Style>
 <Style x:Key="AiDisclosure" TargetType="Expander">
  <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
   <StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Stretch" Background="Transparent" Foreground="{TemplateBinding Foreground}" Cursor="Hand">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="HeaderSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="5,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Path x:Name="Chevron" Data="M 1,1 L 5,5 L 1,9" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Width="6" Height="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform/></Path.RenderTransform></Path>
       <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch"/>
      </Grid>
     </Border><ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource AppleSubtleHoverBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource AiAccentBrush}"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"/>
    </ToggleButton>
    <Border x:Name="ExpandedBody" Visibility="Collapsed" Margin="23,2,0,0"><ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch"/></Border>
   </StackPanel>
   <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="AiToolCallTemplate">
  <StackPanel Margin="0,0,0,3">
   <Expander Style="{StaticResource AiDisclosure}" IsExpanded="{Binding IsDetailExpanded,Mode=TwoWay}">
    <Expander.Header><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding ToolMarker}" Foreground="{StaticResource AiAccentBrush}" VerticalAlignment="Center" FontSize="13"/>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13"/><TextBlock Text="{Binding ToolCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid></Expander.Header>
    <Border Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,0,10">
     <StackPanel>
      <TextBlock Text="调用结果" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Visibility="{Binding Detail,Converter={StaticResource BoolToVis}}"/>
      <motion:TaskProgressView Task="{Binding TaskProgress}" InlineDetails="True" IsExpanded="True" Accent="{StaticResource AiAccentBrush}" Margin="0,12,0,0" Visibility="{Binding HasTaskProgress,Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding ToolCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Visibility="{Binding IsToolRunning,Converter={StaticResource BoolToVis}}"/>
     </StackPanel>
    </Border>
   </Expander>
   <ProgressBar Style="{StaticResource AppleProgressBar}" Value="{Binding TaskProgress.Percent,Mode=OneWay,FallbackValue=0}" Height="5" Maximum="100" Foreground="{StaticResource AiAccentBrush}" Margin="45,0,5,8" Visibility="{Binding HasActiveTaskProgress,Converter={StaticResource BoolToVis}}"/>
  </StackPanel>
 </DataTemplate>
 <DataTemplate DataType="{x:Type vm:AgentToolGroupItem}">
  <Expander Style="{StaticResource AiDisclosure}" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" Margin="0,3,0,8">
   <Expander.Header><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/><StackPanel Orientation="Horizontal"><Border Width="16" Height="16" CornerRadius="4" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" Margin="0,0,8,0"><TextBlock Text="›" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel></DockPanel></Expander.Header>
   <Border BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,0"><ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource AiToolCallTemplate}"/></Border>
  </Expander>
 </DataTemplate>
 <DataTemplate DataType="{x:Type vm:AgentTimelineItem}">
  <Grid>
   <Image Source="/NovainaLauncher;component/Assets/Brand/LauncherIcon.png" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style></Image>
   <Border motion:RevealMotion.Enabled="True">
    <Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="20"/><Style.Triggers>
     <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="MaxWidth" Value="680"/><Setter Property="Margin" Value="60,4,0,6"/><Setter Property="Padding" Value="18,12"/><Setter Property="Background" Value="{StaticResource AiUserBubbleBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Margin" Value="32,0,0,0"/></DataTrigger>
     <DataTrigger Binding="{Binding IsApproval}" Value="True"><Setter Property="Background" Value="{DynamicResource AppleCardBrush}"/><Setter Property="BorderBrush" Value="#66FF9F0A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/></DataTrigger>
    </Style.Triggers></Style></Border.Style>
    <StackPanel>
     <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Margin" Value="0,0,0,10"/><Style.Triggers><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsQuestionResolved}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#E89355"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <motion:MarkdownText Text="{Binding Text}" EnableMarkdown="{Binding IsAssistant}" Visibility="{Binding Text,Converter={StaticResource BoolToVis}}"/>
     <ProgressBar Style="{StaticResource AppleProgressBar}" Value="{Binding Progress}" Maximum="100" Height="6" Margin="0,12,0,0" Visibility="{Binding HasProgress,Converter={StaticResource BoolToVis}}" Foreground="{StaticResource AiAccentBrush}"/>
     <motion:TaskProgressView Task="{Binding TaskProgress}" IsExpanded="{Binding IsProgressExpanded,Mode=TwoWay}" Accent="{StaticResource AiAccentBrush}" Visibility="{Binding HasTaskProgress,Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"/>
     <Expander Header="详细信息" Style="{StaticResource AiDisclosure}" Visibility="{Binding HasPlainDetail,Converter={StaticResource BoolToVis}}" Margin="0,10,0,0"><TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0"/></Expander>
     <StackPanel Visibility="{Binding IsQuestionPending,Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding Questions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><motion:AdaptiveQuestionPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource AppleCardBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
        <StackPanel><TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
         <ListBox Style="{StaticResource VirtualList}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption,Mode=TwoWay}" ItemContainerStyle="{StaticResource AiQuestionChoice}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,5"><DockPanel><TextBlock DockPanel.Dock="Right" Text="推荐" Foreground="{StaticResource AiAccentBrush}" FontSize="11" Margin="10,0,0,0" Visibility="{Binding Recommended,Converter={StaticResource BoolToVis}}"/><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="13"/></DockPanel><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
         <DockPanel Margin="0,10,0,0"><TextBlock Text="自定义" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Style="{StaticResource AppleTextBox}" Text="{Binding CustomInput,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" ToolTip="自定义回答" AutomationProperties.Name="自定义回答"/></DockPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button Content="继续" HorizontalAlignment="Right" Style="{StaticResource AiActionButton}" Command="{Binding SubmitAnswersCommand}" Margin="0,16,0,0"/>
     </StackPanel>
     <Expander Header="{Binding QuestionSummaryTitle}" Style="{StaticResource AiDisclosure}" IsExpanded="{Binding IsQuestionExpanded,Mode=TwoWay}" Visibility="{Binding IsQuestionResolved,Converter={StaticResource BoolToVis}}">
      <ItemsControl ItemsSource="{Binding Answers}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1,0,0,0" Padding="14,6,0,6" Margin="0,0,0,8"><StackPanel>
        <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Answer}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="14"/>
        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Visibility="{Binding Description,Converter={StaticResource BoolToVis}}"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </Expander>
     <StackPanel Visibility="{Binding IsApproval,Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanRespond}" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="取消" Style="{StaticResource AppleSecondaryButton}" Command="{Binding DeclineCommand}" Margin="0,0,8,0"/><Button Content="确认" Style="{StaticResource AiActionButton}" Command="{Binding ApproveCommand}"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </DataTemplate>
</ResourceDictionary>
