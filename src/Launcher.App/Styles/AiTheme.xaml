<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <LinearGradientBrush x:Key="AiAccentBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#007AFF" Offset="0"/><GradientStop Color="#AF52DE" Offset="1"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="AiUserBubbleBrush" StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#30007AFF"/><GradientStop Color="#28AF52DE" Offset="1"/></LinearGradientBrush>
 <SolidColorBrush x:Key="AiChoiceSelectedBrush" Color="#E2EEFC"/>
 <SolidColorBrush x:Key="AiChoiceHoverBrush" Color="#F0F5FC"/>
 <Style x:Key="AiQuestionChoice" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="Choice" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,8,0,0"><Ellipse Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1"/><Ellipse x:Name="SelectedFill" Fill="{StaticResource AiAccentBrush}" Visibility="Collapsed"/><TextBlock x:Name="SelectedTick" Text="✓" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
     <ContentPresenter Grid.Column="1"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AiChoiceSelectedBrush}"/><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AiAccentBrush}"/><Setter TargetName="SelectedFill" Property="Visibility" Value="Visible"/><Setter TargetName="SelectedTick" Property="Visibility" Value="Visible"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Choice" Property="Background" Value="{DynamicResource AiChoiceHoverBrush}"/></MultiTrigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AiAccentBrush}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="AiModeToggle" TargetType="CheckBox">
  <Setter Property="Width" Value="32"/><Setter Property="Height" Value="20"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid><Border x:Name="Track" CornerRadius="10" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource AppleCardBorderBrush}" BorderThickness="1"/>
    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource AiAccentBrush}"/><Setter TargetName="Track" Property="BorderThickness" Value="0"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
