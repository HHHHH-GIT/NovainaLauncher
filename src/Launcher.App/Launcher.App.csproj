<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.17763.57</WindowsSdkPackageVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NovainaLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/LauncherIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>Novaina Launcher</Product>
    <Title>Novaina Launcher</Title>
    <Description>AI Minecraft Launcher</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Loaders/*" />
    <Resource Include="Assets/Brand/*.png" />
    <Resource Include="Assets/Brand/*.ico" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <ProjectReference Include="../Launcher.Core/Launcher.Core.csproj" />
    <ProjectReference Include="../Launcher.AI/Launcher.AI.csproj" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/SkinViewer/*" LogicalName="Novaina.Asset/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/**/LICENSE*" LogicalName="Novaina.License/App/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty/**/NOTICE*" LogicalName="Novaina.License/App/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Launcher.Core/ThirdParty/**/LICENSE*" LogicalName="Novaina.License/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Launcher.Core/ThirdParty/**/NEOFORGE-LICENSE*" LogicalName="Novaina.License/Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Launcher.AI/ThirdParty/**/LICENSE*" LogicalName="Novaina.License/AI/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/THIRD-PARTY-NOTICES.md" LogicalName="Novaina.License/THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Novaina.License/LICENSE.txt" />
  </ItemGroup>
  <Target Name="RemoveSingleFileSidecars" AfterTargets="ComputeFilesToPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('ThirdParty')) or '%(Extension)' == '.pdb' or ($([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2.')) and '%(Extension)' == '.xml')" />
    </ItemGroup>
  </Target>
</Project>
