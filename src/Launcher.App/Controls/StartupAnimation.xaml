<UserControl x:Class="Launcher.App.Controls.StartupAnimation"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="False" IsHitTestVisible="False" ClipToBounds="True">
 <Grid>
  <Border x:Name="Curtain" Background="{DynamicResource PopupBrush}"/>
  <Grid Width="360" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center">
   <Ellipse x:Name="BlueHalo" Width="360" Height="360" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Ellipse.Fill><RadialGradientBrush Center="0.43,0.48" GradientOrigin="0.43,0.48">
     <GradientStop Color="#BF007AFF" Offset="0"/><GradientStop Color="#70007AFF" Offset="0.3"/><GradientStop Color="#00007AFF" Offset="1"/>
    </RadialGradientBrush></Ellipse.Fill>
    <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
   </Ellipse>
   <Ellipse x:Name="PurpleHalo" Width="360" Height="360" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Ellipse.Fill><RadialGradientBrush Center="0.59,0.52" GradientOrigin="0.59,0.52">
     <GradientStop Color="#D0AF52DE" Offset="0"/><GradientStop Color="#70AF52DE" Offset="0.3"/><GradientStop Color="#00AF52DE" Offset="1"/>
    </RadialGradientBrush></Ellipse.Fill>
    <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
   </Ellipse>
   <Ellipse x:Name="Shockwave" Width="180" Height="180" Opacity="0" Stroke="{StaticResource AiAccentBrush}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
    <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
   </Ellipse>
   <Ellipse x:Name="CoreFlash" Width="210" Height="210" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Ellipse.Fill><RadialGradientBrush>
     <GradientStop Color="#DAE6EFFF" Offset="0"/><GradientStop Color="#88007AFF" Offset="0.2"/><GradientStop Color="#30AF52DE" Offset="0.5"/><GradientStop Color="#00AF52DE" Offset="1"/>
    </RadialGradientBrush></Ellipse.Fill>
    <Ellipse.RenderTransform><ScaleTransform ScaleX="0.3" ScaleY="0.3"/></Ellipse.RenderTransform>
   </Ellipse>
  </Grid>
  <Canvas x:Name="Fragments" Width="176" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  <Image x:Name="Star" Width="176" Height="176" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor">
   <Image.Source><BitmapImage UriSource="/NovainaLauncher;component/Assets/Brand/LauncherIcon.png" DecodePixelWidth="192" CacheOption="OnLoad"/></Image.Source>
   <Image.RenderTransform><ScaleTransform ScaleX="0.86" ScaleY="0.86"/></Image.RenderTransform>
  </Image>
 </Grid>
</UserControl>
